# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# The dataset lives outside the checkout; data/ is a symlink (scripts/link_data.sh)
/data

# Training outputs. The small per-run records that back the paper are tracked
# under results/runs/ and results/tables/; everything else a run writes is not.
/results/*
!/results/README.md
!/results/runs/
!/results/tables/
results/runs/**/checkpoints/
/results/runs/.cache/
*.pt
*.pth
*.ckpt

# LaTeX build output; paper/src/ builds in place
/paper/src/*.aux
/paper/src/*.bbl
/paper/src/*.blg
/paper/src/*.fdb_latexmk
/paper/src/*.fls
/paper/src/*.log
/paper/src/*.out
/paper/src/main.pdf

# Editor / OS
.DS_Store
.idea/
.vscode/
